# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts and macOS executables must always have LF line endings
*.sh text eol=lf
*.command text eol=lf
postinstall text eol=lf
preinstall text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.praat text eol=lf
*.png binary
